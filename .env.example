# SmartBuy environment variables.
# Copy this file to .env.local for local development, and add the same names
# in Vercel (Project > Settings > Environment Variables) for the deployed app.
# Never commit real values and never paste secret values into a chat.

# --- Supabase (required) -----------------------------------------------------
# Supabase dashboard > your project > Connect, or Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server only. Lets the app store prices and alerts.
SUPABASE_SECRET_KEY=

# --- Product data source (required for live prices) --------------------------
# https://serpapi.com > Dashboard > API key.
SERPAPI_API_KEY=

# --- Alert emails through Gmail (optional; alerts still show in-app) ----------
GMAIL_USER=
# A 16-character Google "app password", not the normal Gmail password.
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=SmartBuy

# --- Scheduled price collection (required on Vercel) -------------------------
# Any long random string. Vercel sends it to /api/cron/collect.
CRON_SECRET=

# --- Site address (recommended) ----------------------------------------------
# The public address of the app, used in email links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Limits (optional; defaults shown) ---------------------------------------
# Data-source lookups allowed per calendar month.
PROVIDER_MONTHLY_LIMIT=250
# Live lookups one signed-in member may trigger in 24 hours.
USER_DAILY_LIVE_LIMIT=15
# Tracked products refreshed by each daily collection run.
COLLECT_MAX_PRODUCTS=6
# Hours a search result set / a product's store offers are reused.
SEARCH_CACHE_HOURS=12
OFFERS_CACHE_HOURS=12
# A price older than this many hours never triggers an alert.
FRESH_PRICE_HOURS=36
